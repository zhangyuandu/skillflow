#!/usr/bin/env node
/**
 * SkillFlow CLI
 * 
 * 用法:
 *   skillflow plan "任务描述"       # 生成执行计划
 *   skillflow execute <plan.json>  # 执行计划
 *   skillflow run "任务描述"       # 规划+执行
 *   skillflow status              # 查看状态
 *   skillflow history             # 查看执行历史
 *   skillflow skills              # 列出可用技能
 *   skillflow test                # 运行测试
 */

const path = require('path');
const fs = require('fs');

// 加载核心模块
const corePath = path.join(__dirname, '..', 'src', 'index.js');
const pipelinePath = path.join(__dirname, '..', 'src', 'pipeline.js');
const historyPath = path.join(__dirname, '..', 'src', 'history.js');
const parallelPath = path.join(__dirname, '..', 'src', 'parallel.js');

let skillflow, Pipeline, getHistoryManager, ParallelExecutor;
try {
  skillflow = require(corePath);
  Pipeline = require(pipelinePath).Pipeline;
  getHistoryManager = require(historyPath).getHistoryManager;
  ParallelExecutor = require(parallelPath).ParallelExecutor;
} catch (e) {
  console.error('❌ 无法加载 SkillFlow 核心模块:', e.message);
  process.exit(1);
}

// ============================================================================
// 配置管理
// ============================================================================

const CONFIG_PATH = path.join(process.env.HOME, '.openclaw', 'skillflow-config.json');

function loadConfig() {
  const defaultConfig = {
    execution: {
      parallel: true,
      maxConcurrency: 5,
      timeout: 60000
    },
    logging: {
      verbose: false
    }
  };
  
  try {
    if (fs.existsSync(CONFIG_PATH)) {
      const userConfig = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf-8'));
      return { ...defaultConfig, ...userConfig };
    }
  } catch (e) {
    // 忽略
  }
  return defaultConfig;
}

function saveConfig(config) {
  const dir = path.dirname(CONFIG_PATH);
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }
  fs.writeFileSync(CONFIG_PATH, JSON.stringify(config, null, 2));
}

// ============================================================================
// CLI 命令
// ============================================================================

const pkg = require('../package.json');

const commands = {
  /**
   * 显示版本
   */
  async version() {
    console.log(`🌊 SkillFlow v${pkg.version}`);
    console.log(`   并行执行: ${ParallelExecutor ? '✅ 支持' : '❌ 不支持'}`);
  },

  /**
   * 显示配置
   */
  async config(args) {
    const config = loadConfig();
    
    if (args[0] === 'set') {
      const key = args[1];
      const value = args[2];
      
      if (!key || value === undefined) {
        console.log('用法: skillflow config set <key> <value>');
        console.log('例如: skillflow config set execution.maxConcurrency 3');
        process.exit(1);
      }
      
      // 解析嵌套key
      const keys = key.split('.');
      let obj = config;
      for (let i = 0; i < keys.length - 1; i++) {
        if (!obj[keys[i]]) obj[keys[i]] = {};
        obj = obj[keys[i]];
      }
      
      // 转换值类型
      let finalValue = value;
      if (value === 'true') finalValue = true;
      else if (value === 'false') finalValue = false;
      else if (!isNaN(value)) finalValue = Number(value);
      
      obj[keys[keys.length - 1]] = finalValue;
      saveConfig(config);
      console.log(`✅ 已设置 ${key} = ${finalValue}`);
      return;
    }
    
    console.log('📋 SkillFlow 配置\n');
    console.log(JSON.stringify(config, null, 2));
    console.log('\n用法: skillflow config set <key> <value>');
  },

  /**
   * 运行测试
   */
  async test(args) {
    const isParallel = args.includes('--parallel') || args.includes('-p');
    const verbose = args.includes('--verbose') || args.includes('-v');
    
    console.log('🧪 SkillFlow 测试\n');
    
    const tests = [
      { name: 'Planner Tests', file: 'tests/unit/planner.test.js' },
      { name: 'Executor Tests', file: 'tests/unit/executor.test.js' },
      { name: 'Integration Tests', file: 'tests/integration/orchestration.test.js' }
    ];
    
    if (isParallel) {
      tests.push({ name: 'Parallel Tests', file: 'tests/integration/parallel.test.js' });
    }
    
    let passed = 0;
    let failed = 0;
    
    for (const test of tests) {
      const testPath = path.join(__dirname, '..', test.file);
      
      if (!fs.existsSync(testPath)) {
        if (verbose) console.log(`  ⏭️  ${test.name}: 跳过 (文件不存在)`);
        continue;
      }
      
      if (verbose) console.log(`\n📝 ${test.name}...`);
      
      try {
        const { execSync } = require('child_process');
        const result = execSync(`node "${testPath}"`, { 
          cwd: path.join(__dirname, '..'),
          encoding: 'utf-8',
          stdio: 'pipe'
        });
        
        if (result.includes('passed')) {
          console.log(`  ✅ ${test.name}: 通过`);
          passed++;
        } else {
          console.log(`  ⚠️  ${test.name}: 结果未知`);
        }
      } catch (e) {
        if (e.stdout && e.stdout.includes('passed')) {
          console.log(`  ✅ ${test.name}: 通过`);
          passed++;
        } else {
          console.log(`  ❌ ${test.name}: 失败`);
          failed++;
          if (verbose) console.log(`     ${e.message}`);
        }
      }
    }
    
    console.log(`\n📊 测试结果: ${passed} 通过, ${failed} 失败`);
    
    if (failed > 0) {
      process.exit(1);
    }
  },

  /**
   * 生成执行计划
   */
  async plan(args) {
    const task = args.join(' ');
    if (!task) {
      console.error('❌ 请提供任务描述');
      console.log('用法: skillflow plan "搜索AI新闻并总结"');
      process.exit(1);
    }
    
    console.log('📋 生成执行计划...\n');
    console.log('任务:', task);
    
    const config = loadConfig();
    if (config.logging.verbose) {
      console.log('配置:', JSON.stringify(config.execution));
    }
    
    try {
      const result = await skillflow.plan(task);
      
      console.log('\n发现的技能:', result.skills.join(', '));
      console.log('\n执行计划:');
      result.plan.forEach((step, i) => {
        const deps = step.depends_on?.length ? ` (依赖: ${step.depends_on.join(', ')})` : '';
        console.log(`  ${i + 1}. [${step.action}] ${step.skill_hint}${deps}`);
      });
      
      // 保存计划到文件
      const planFile = `.skillflow-plan-${Date.now()}.json`;
      fs.writeFileSync(planFile, JSON.stringify(result, null, 2));
      console.log(`\n✅ 计划已保存到: ${planFile}`);
      
    } catch (error) {
      console.error('❌ 生成计划失败:', error.message);
      process.exit(1);
    }
  },

  /**
   * 执行计划
   */
  async execute(args) {
    const planFile = args[0];
    if (!planFile) {
      console.error('❌ 请提供计划文件');
      console.log('用法: skillflow execute plan.json');
      process.exit(1);
    }
    
    if (!fs.existsSync(planFile)) {
      console.error('❌ 计划文件不存在:', planFile);
      process.exit(1);
    }
    
    const planData = JSON.parse(fs.readFileSync(planFile, 'utf-8'));
    console.log('🚀 执行计划...\n');
    
    const config = loadConfig();
    
    try {
      const options = {
        parallel: config.execution.parallel,
        maxConcurrency: config.execution.maxConcurrency,
        timeout: config.execution.timeout
      };
      
      if (config.logging.verbose) {
        console.log('执行选项:', JSON.stringify(options));
      }
      
      const result = await skillflow.run(planData.task || planData.plan[0]?.action, options);
      
      if (result.success) {
        console.log('✅ 执行成功');
        console.log('\n执行历史:');
        result.execution.history.forEach((h, i) => {
          console.log(`  ${i + 1}. ${h.stepId} - ${h.action} ${h.success ? '✅' : '❌'}`);
        });
        console.log('\n最终结果:', JSON.stringify(result.result, null, 2));
      } else {
        console.log('❌ 执行失败:', result.error);
      }
      
    } catch (error) {
      console.error('❌ 执行失败:', error.message);
      process.exit(1);
    }
  },

  /**
   * 规划并执行
   */
  async run(args) {
    const task = args.join(' ');
    if (!task) {
      console.error('❌ 请提供任务描述');
      console.log('用法: skillflow run "搜索AI新闻并总结"');
      process.exit(1);
    }
    
    console.log('🎯 执行任务:', task);
    
    const config = loadConfig();
    const options = {
      parallel: config.execution.parallel,
      maxConcurrency: config.execution.maxConcurrency,
      timeout: config.execution.timeout
    };
    
    if (config.logging.verbose) {
      console.log('配置:', JSON.stringify(options));
    }
    
    try {
      const result = await skillflow.run(task, options);
      
      if (result.success) {
        console.log('\n✅ 任务完成');
        console.log('步骤:', result.execution.history.length);
        
        // 记录到历史
        const history = getHistoryManager();
        history.record({
          task,
          success: true,
          skills: result.skills || [],
          duration: result.execution.history.reduce((sum, h) => sum + (h.duration || 0), 0)
        });
        
      } else {
        console.log('\n❌ 任务失败:', result.error);
      }
      
    } catch (error) {
      console.error('❌ 执行失败:', error.message);
      process.exit(1);
    }
  },

  /**
   * 查看状态
   */
  async status() {
    console.log('📊 SkillFlow 状态\n');
    
    const history = getHistoryManager();
    const stats = history.stats();
    const config = loadConfig();
    
    console.log('执行配置:');
    console.log(`  并行执行: ${config.execution.parallel ? '✅ 启用' : '❌ 禁用'}`);
    console.log(`  最大并发: ${config.execution.maxConcurrency}`);
    console.log(`  超时时间: ${config.execution.timeout}ms`);
    
    console.log('\n执行统计:');
    console.log(`  总执行次数: ${stats.total}`);
    console.log(`  成功率: ${stats.successRate}`);
    console.log(`  平均耗时: ${stats.avgDuration}ms`);
    
    console.log('\n技能使用频率:');
    Object.entries(stats.skillUsage)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5)
      .forEach(([skill, count]) => {
        console.log(`  ${skill}: ${count} 次`);
      });
  },

  /**
   * 查看执行历史
   */
  async history(args) {
    const limit = parseInt(args[0]) || 10;
    const history = getHistoryManager();
    const records = history.recent(limit);
    
    console.log(`📜 最近 ${records.length} 条执行记录\n`);
    
    records.forEach((record, i) => {
      const time = new Date(record.timestamp).toLocaleString('zh-CN');
      const status = record.success ? '✅' : '❌';
      const task = (record.task || '未知任务').substring(0, 40);
      
      console.log(`${i + 1}. ${status} ${time}`);
      console.log(`   任务: ${task}`);
      if (record.skills?.length) {
        console.log(`   技能: ${record.skills.join(', ')}`);
      }
      console.log('');
    });
  },

  /**
   * 列出可用技能
   */
  async skills() {
    console.log('🔧 可用技能\n');
    
    try {
      const skills = await skillflow.discoverSkills();
      
      Object.values(skills).forEach((skill, i) => {
        console.log(`${i + 1}. ${skill.name}`);
        console.log(`   能力: ${skill.capabilities.slice(0, 5).join(', ')}`);
        console.log('');
      });
      
      console.log(`共 ${Object.keys(skills).length} 个技能`);
      
    } catch (error) {
      console.error('❌ 获取技能列表失败:', error.message);
    }
  },

  /**
   * Pipeline 模式
   */
  async pipeline(args) {
    const pipelineFile = args[0];
    if (!pipelineFile) {
      console.error('❌ 请提供 Pipeline 配置文件');
      console.log('用法: skillflow pipeline pipeline.json');
      process.exit(1);
    }
    
    console.log('🔄 执行 Pipeline...\n');
    
    const pipe = new Pipeline('custom');
    pipe.stage('start', data => data);
    
    const result = await pipe.run({ input: pipelineFile });
    console.log('✅ Pipeline 执行完成');
    console.log(pipe.visualize());
  },

  /**
   * 帮助
   */
  help() {
    console.log(`
🌊 SkillFlow - 通用智能任务编排引擎 v${pkg.version}

用法:
  skillflow <command> [args]

命令:
  plan "任务"          生成执行计划
  execute <file>       执行计划文件
  run "任务"           规划并执行
  status               查看状态统计
  history [n]          查看最近 n 条历史
  skills               列出可用技能
  pipeline <file>      执行 Pipeline
  test [--parallel]    运行测试
  config [set <k> <v>] 查看/设置配置
  version              显示版本
  help                 显示帮助

选项:
  --version, -v       显示版本
  --parallel, -p       并行模式
  --verbose, -v        详细输出

示例:
  skillflow plan "搜索AI新闻，总结后保存到飞书文档"
  skillflow run "分析代码库并生成报告"
  skillflow history 5
  skillflow test --parallel
  skillflow config set execution.maxConcurrency 3

配置文件:
  ${CONFIG_PATH}

文档:
  https://github.com/zhangyuandu/skillflow
`);
  }
};

// ============================================================================
// 入口
// ============================================================================

async function main() {
  const args = process.argv.slice(2);
  const command = args[0] || 'help';
  const commandArgs = args.slice(1);

  // Handle --version flag
  if (command === '--version' || command === '-v') {
    await commands.version();
    return;
  }

  if (commands[command]) {
    await commands[command](commandArgs);
  } else {
    console.error(`❌ 未知命令: ${command}`);
    console.log('运行 `skillflow help` 查看帮助');
    process.exit(1);
  }
}

main().catch(error => {
  console.error('❌ 错误:', error.message);
  process.exit(1);
});
